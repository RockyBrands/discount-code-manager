# ── Shopify app credentials ──────────────────────────────────────────────
# Partner Dashboard → Apps → your app → Settings → Credentials
# ("Client ID" and "Client secret"). The app must be a custom app with
# Plus organization distribution to install on all brand stores.
SHOPIFY_API_KEY=...
SHOPIFY_API_SECRET=...

# Public base URL of this app. Must exactly match the App URL in
# Partner Dashboard → Settings → URLs, and the OAuth redirect must be
# listed there as APP_URL/api/shopify/callback.
# Local dev: http://localhost:3000 — Prod: https://your-site.netlify.app
APP_URL=http://localhost:3000

# ── Secrets (generate locally, never commit real values) ─────────────────
# AES-256-GCM key used to encrypt shop access tokens stored in the DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# On Netlify: Site settings → Environment variables.
TOKEN_ENCRYPTION_KEY=<base64 32 bytes>

# Shared secret authenticating Netlify background/scheduled functions to
# /api/internal/process-removals. Any random string works.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SHARED_SECRET=<hex>

# ── Staff sign-in ─────────────────────────────────────────────────────────
# None needed. The app is embedded in Shopify admin; staff access is gated by
# Shopify session tokens (verified against SHOPIFY_API_SECRET). Anyone who can
# open the app from an installed store's admin can use it.

# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Neon console (neon.tech) → your project → Connect.
# DATABASE_URL: the *pooled* connection string (host contains "-pooler") —
# serverless functions need the pooler. Include ?sslmode=require.
# DIRECT_URL: the *unpooled* endpoint (same string without "-pooler").
# Used by `prisma migrate deploy` at build time.
#
# Locally, put these two in a `.env` file (not `.env.local`) so the Prisma
# CLI picks them up for `migrate dev`/`migrate deploy`. `.env` is gitignored.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require