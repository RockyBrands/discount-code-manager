# Shopify Configuration - Add one for each brand store
SHOPIFY_ROCKY_SHOP_DOMAIN=rocky.myshopify.com
SHOPIFY_ROCKY_ACCESS_TOKEN=your-rocky-admin-api-access-token

SHOPIFY_GEORGIA_SHOP_DOMAIN=georgia.myshopify.com
SHOPIFY_GEORGIA_ACCESS_TOKEN=your-georgia-admin-api-access-token

SHOPIFY_DURANGO_SHOP_DOMAIN=durango.myshopify.com
SHOPIFY_DURANGO_ACCESS_TOKEN=your-durango-admin-api-access-token

SHOPIFY_MUCK_SHOP_DOMAIN=muck.myshopify.com
SHOPIFY_MUCK_ACCESS_TOKEN=your-muck-admin-api-access-token

SHOPIFY_XTRATUF_SHOP_DOMAIN=xtratuf.myshopify.com
SHOPIFY_XTRATUF_ACCESS_TOKEN=your-xtratuf-admin-api-access-token

SHOPIFY_RANGER_SHOP_DOMAIN=ranger.myshopify.com
SHOPIFY_RANGER_ACCESS_TOKEN=your-ranger-admin-api-access-token

SHOPIFY_LEHIGH_OUTFITTERS_SHOP_DOMAIN=lehigh-outfitters.myshopify.com
SHOPIFY_LEHIGH_OUTFITTERS_ACCESS_TOKEN=your-lehigh-outfitters-admin-api-access-token

SHOPIFY_LEHIGH_SAFETY_SHOP_DOMAIN=lehigh-safety.myshopify.com
SHOPIFY_LEHIGH_SAFETY_ACCESS_TOKEN=your-lehigh-safety-admin-api-access-token

SHOPIFY_SLIPGRIPS_SHOP_DOMAIN=slipgrips.myshopify.com
SHOPIFY_SLIPGRIPS_ACCESS_TOKEN=your-slipgrips-admin-api-access-token

SHOPIFY_HARD_YAKKA_SHOP_DOMAIN=hard-yakka.myshopify.com
SHOPIFY_HARD_YAKKA_ACCESS_TOKEN=your-hard-yakka-admin-api-access-token

SHOPIFY_API_VERSION=2024-01

# Google OAuth Configuration
GOOGLE_CLIENT_ID=example
GOOGLE_CLIENT_SECRET=example
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=example

# Allowed domains for authentication
ALLOWED_DOMAINS=rockybrands.com,lehigh.com,lehighoutfitters.com
