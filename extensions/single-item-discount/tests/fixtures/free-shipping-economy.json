                    "deliveryOption": {
                      "handle": "economy-shipping"
                    }
                  }
                ],
                "value": {
                  "percentage": {
                    "value": 100.0
                  }
                }
              }
            ],
            "selectionStrategy": "ALL"
          }
        }
      ]
